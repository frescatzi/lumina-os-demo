# The demo needs no key and does not read this file automatically.
# Export these variables in your shell, or pass the file with `uv run --env-file .env`.
# Empty values fall back to the defaults.
# SQLite database path (default: data/lumina.db)
LUMINA_DB=
# Model name per tier (default: offline-small, offline-medium, offline-large).
# Only the offline provider ships; a real model name needs a provider in lumina/router.py.
LUMINA_MODEL_SMALL=
LUMINA_MODEL_MEDIUM=
LUMINA_MODEL_LARGE=
